{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/:path*.rsc",
      "headers": [
        { "key": "Content-Type", "value": "text/x-component" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
